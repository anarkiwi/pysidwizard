// SID-Wizard's play call, every build: the L.* flags are the features and release differences of
// the player in the image, and each player variable is state that starts from what the init left
// (L.init_*). Voices play last first, then the shared filter and volume registers. Each voice
// counts ticks against a tempo program; tick 0 reads a row and hard-restarts its note, tick 1
// steps the pattern and orderlist, tick 2 starts the note, other ticks run the instrument:
// vibrato and slides, then its filter, pulse and waveform tables. A multispeed call runs only
// the tables.
spec sidwizard;

layout {
  exptabh, exptabh_m1, exptbase, freqtbh, freqtbl, p_chdp1, p_chdt1, p_insh3, p_insl3, p_ptnh1,
  p_ptnl1, p_subt1, p_subt2, p_tmpp1, sfxleng, sfxtimer, sid, swp_base, tempotbl, vib_hi, vib_lo:
  addr;
  chn, exp_end, exp_threshold, gate_mask, init_ckbdtrk, init_curinstemp, init_cutoff,
  init_cwepcnt, init_flshift, init_fltband, init_fltctrl, init_fltposi, init_fswitch, init_gate,
  init_insctrl, init_main_tempo, init_mainvol, init_resonib, init_seqvolu, init_subtjmp,
  init_subtpos, init_tablrst, init_valstor, init_zp, sel_ins_limit: byte;
  init_freq, init_pw, init_wfghost, init_ptngate, init_pweepcnt, init_packcnt, init_spdcnt,
  init_seqpos, init_ptnpos, init_wftpos, init_pwtpos, init_arpscnt, init_curptn, init_curnot,
  init_dpitch, init_curifx, init_curins, init_curfx2, init_curval, init_slidevib, init_freqmod,
  init_videlcnt, init_vibfrequ, init_vibracnt, init_transp, init_tmpbase, init_tmppos,
  init_arpsped, init_pkbdtrk, init_curchord, init_chordpos, init_flswtbl, init_flswtb2,
  init_trktmpos, init_seqtempo, init_transp2, init_detuner, init_trdelay, init_seqt, init_g_freq,
  init_g_pw, init_g_wave, init_g_ad, init_g_sr, order: list;
  allghostregs, arpspeedsupp, bigfx0d_falls, bigfx1f_toggle, bigfx_delay_16, bigfx_v10,
  calcvibrato, chordsupport, delaysupport, detune_smallfx, detunesupport, echo_support,
  fastspeedbind, filt_ctrl_fx, filter_smallfx, filter_stop_rewinds, filteralways, filtkbtrack,
  filtresetsw, filtshift_supp, finefiltsweep, first_frame_fixed_waveform,
  first_frame_freq_by_track, frame1switch, gate_minus, gateoffptr, hardrestypes, hrender_inline,
  hrgtoff_or8, kbtrack_fswitch, mulply, multispeedsupp, noins_rts, octaveshift, play_gate,
  portame_notefx, portavibra, pulsealways, pwkeybtrack, pwresetsw, restart_trdelay,
  retainzeropage, seq_fx_support, seq_tempo_capped, sfx, sound_resets_flshift, subtune_restarts,
  subtunejump, swp, table_fx_resets, tempoprgsupp, transposesupp, vibamfx_amp_only,
  vibfreqfx_supp, vibratotypes, vibslidealways, wfarp_nop_supp, wfctrl_fx_stores, wfctrl_smallfx:
  flag;
}

const LEGATO = 0x3F;
const PORTAMENTO = 0x03;
const NOTE_FX = 0x60;
const TONE_PORTA = 0x83;
const NOTE_PORTA = 0xFF;
const WAVE_START = 0x10;

event pulse: tick;
event filter: tick;
event advance: tick;
event pattern_end: tick;
event wave: tick;

// Song data: instruments and patterns through their pointer tables, the orderlists, chords,
// tempo programs and subtunes. The instrument read is the one any voice last pointed at; a call
// that keeps the zero page starts from the pointer the init left.
state ins: u16 = L.init_zp;
cell insptr: u16[256] @ (L.p_insl3, L.p_insh3) ro;
cell ptnptr: u16[256] @ (L.p_ptnl1, L.p_ptnh1) ro;
table insdata @ ins stride 1 { b: u8; }
view instrument @ ins {
  control @ 0; hr_ad @ 1; hr_sr @ 2; ad @ 3; sr @ 4; vibrato @ 5; vibrato_delay @ 6;
  arp_speed @ 7; chord @ 8; octave @ 9; pw_start @ 10; filter_start @ 11; gateoff_wf @ 12;
  gateoff_pw @ 13; gateoff_filter @ 14; first_wave @ 15;
}
table orderlist via seqt stride 1 { b: u8; }
cell tmpp: u8[256] @ L.p_tmpp1 ro;
cell chdt: u8[256] @ L.p_chdt1 ro;
cell chdp: u8[256] @ L.p_chdp1 ro;
cell subt1: u8[256] @ L.p_subt1 ro;
cell subt2: u8[256] @ L.p_subt2 ro;
cell tempotbl: u8[256] @ L.tempotbl;

// The player's tables: note frequencies, and the exponents slides and keyboard tracks scale by.
cell freqtbl: u8[256] @ L.freqtbl ro notes(lo, -1);
cell freqtbh: u8[256] @ L.freqtbh ro notes(hi, -1);
cell exptabh: u8[256] @ L.exptabh ro;
cell exptabh_m1: u8[256] @ L.exptabh_m1 ro;
cell exptbase: u8[256] @ L.exptbase ro;
cell vib_lo: u8[256] @ L.vib_lo ro;
cell vib_hi: u8[256] @ L.vib_hi ro;

// Shared state: the filter, volume, the tables' reset mask, the small-effect value.
state tablrst: u8 = L.init_tablrst;
state insctrl: u8 = L.init_insctrl;
state fltctrl: u8 = L.init_fltctrl;
state fltposi: u8 = L.init_fltposi;
state cwepcnt: u8 = L.init_cwepcnt;
state fswitch: u8 = L.init_fswitch;
state resonib: u8 = L.init_resonib;
state mainvol: u8 = L.init_mainvol;
state fltband: u8 = L.init_fltband;
state ckbdtrk: u8 = L.init_ckbdtrk;
state cutoff: u16 = L.init_cutoff;
state coarse: u8 = L.init_cutoff >> 8;
state flshift: u8 = L.init_flshift;
state seqvolu: u8 = L.init_seqvolu;
state valstor: u8 = L.init_valstor;
state subtpos: u8 = L.init_subtpos;
cell sid_resfc: u8 @ L.sid + 0x17 out;
cell sid_fmvol: u8 @ L.sid + 0x18 out;
cell sid_fcut: u11 @ (L.sid + 0x15 : 3, L.sid + 0x16) out;

state mulcarry: bool = false;
state main_tempo: u8 = L.init_main_tempo;
state subtjmp: u8 = L.init_subtjmp;
state gate: u8 = L.init_gate;
state curinstemp: u8 = L.init_curinstemp;
cell sfxleng: u8 @ L.sfxleng;
cell sfxtimer: u8 @ L.sfxtimer;

owner filter_owner: fltctrl { id x * 7; none 0xFF; on note claim; }

// The filter table of the voice owning the filter: sweep, set (band, resonance, cutoff),
// jump, stop; the third byte is the keyboard track or a filter switch.
cursor filter_table {
  table @ ins width 3;
  pos fltposi; count cwepcnt; values cutoff, coarse, fltband, resonib, ckbdtrk, fswitch;
  on filter step;
  match c0 {
    0..0x7f if L.finefiltsweep => sweep(into=cutoff, count=c0, step=c1, frac=3)
      then fswitch = c2 & 0x0f if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = 0 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = c2 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) != 0x80,
           ckbdtrk = c2 if L.filtkbtrack && !L.kbtrack_fswitch;
    0..0x7f => sweep(into=coarse, count=c0, step=c1)
      then fswitch = c2 & 0x0f if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = 0 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = c2 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) != 0x80,
           ckbdtrk = c2 if L.filtkbtrack && !L.kbtrack_fswitch;
    0x80..0xfd if L.finefiltsweep => value(fltband = c0 & 0x70, resonib = c0 << 4, cutoff.hi = c1, cutoff.lo = 0)
      then cwepcnt = 0,
           fswitch = c2 & 0x0f if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = 0 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = c2 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) != 0x80,
           ckbdtrk = c2 if L.filtkbtrack && !L.kbtrack_fswitch;
    0x80..0xfd => value(fltband = c0 & 0x70, resonib = c0 << 4, coarse = c1)
      then cwepcnt = 0,
           fswitch = c2 & 0x0f if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = 0 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) == 0x80,
           ckbdtrk = c2 if L.filtkbtrack && L.kbtrack_fswitch when (c2 & 0xf0) != 0x80,
           ckbdtrk = c2 if L.filtkbtrack && !L.kbtrack_fswitch;
    0xfe => jump(c1) hold 0..0x7f as 0x80;
    0xff => stop;
  }
}

machine voice[x in 0..L.chn] {
  state freq: u16 = L.init_freq[x];
  state pw: u16 = L.init_pw[x];
  state wfghost: u8 = L.init_wfghost[x];
  state ptngate: u8 = L.init_ptngate[x];
  state pweepcnt: u8 = L.init_pweepcnt[x];
  state packcnt: u8 = L.init_packcnt[x];
  state spdcnt: u8 = L.init_spdcnt[x];
  state seqpos: u8 = L.init_seqpos[x];
  state ptnpos: u8 = L.init_ptnpos[x];
  state wftpos: u8 = L.init_wftpos[x];
  state pwtpos: u8 = L.init_pwtpos[x];
  state arpscnt: u8 = L.init_arpscnt[x];
  state curptn: u8 = L.init_curptn[x];
  state curnot: u8 = L.init_curnot[x];
  state dpitch: u8 = L.init_dpitch[x];
  state curifx: u8 = L.init_curifx[x];
  state curins: u8 = L.init_curins[x];
  state curfx2: u8 = L.init_curfx2[x];
  state curval: u8 = L.init_curval[x];
  state slidevib: u8 = L.init_slidevib[x];
  state freqmod: u16 = L.init_freqmod[x];
  state videlcnt: u8 = L.init_videlcnt[x];
  state vibfrequ: u8 = L.init_vibfrequ[x];
  state vibracnt: u8 = L.init_vibracnt[x];
  state transp: u8 = L.init_transp[x];
  state tmpbase: u8 = L.init_tmpbase[x];
  state tmppos: u8 = L.init_tmppos[x];
  state arpsped: u8 = L.init_arpsped[x];
  state pkbdtrk: u8 = L.init_pkbdtrk[x];
  state curchord: u8 = L.init_curchord[x];
  state chordpos: u8 = L.init_chordpos[x];
  state flswtbl: u8 = L.init_flswtbl[x];
  state flswtb2: u8 = L.init_flswtb2[x];
  state trktmpos: u8 = L.init_trktmpos[x];
  state seqtempo: u8 = L.init_seqtempo[x];
  state transp2: u8 = L.init_transp2[x];
  state detuner: u8 = L.init_detuner[x];
  state trdelay: u8 = L.init_trdelay[x];
  record voice_vars @ 0 stride 7 {
    out_freq: u16 @ L.sid; out_pw: u12 @ L.sid + 2; out_wave: u8 @ L.sid + 4;
    out_ad: u8 @ L.sid + 5; out_sr: u8 @ L.sid + 6;
  }
  // The voice's registers as the player holds them; a build with ghost registers writes the chip
  // from them once all voices have played.
  state g_freq: u16 = L.init_g_freq[x];
  state g_pw: u16 = L.init_g_pw[x];
  state g_wave: u8 = L.init_g_wave[x];
  state g_ad: u8 = L.init_g_ad[x];
  state g_sr: u8 = L.init_g_sr[x];
  state seqt: u16 = L.init_seqt[x];

  // The pulse table: sweep, set, jump, stop; the third byte is the keyboard track.
  cursor pw_table {
    table @ ins width 3;
    pos pwtpos; count pweepcnt; values pw, pkbdtrk;
    on pulse step;
    match c0 {
      0..0x7f => sweep(into=pw, count=c0, step=c1) then pkbdtrk = c2 if L.pwkeybtrack;
      0x80..0xfd => value(pw.hi = c0 & 0x7f, pw.lo = c1) then pkbdtrk = c2 if L.pwkeybtrack, pweepcnt = 0;
      0xfe => jump(c1) hold 0..0x7f as 0x80;
      0xff => stop;
    }
  }

  // The waveform/arpeggio table, read a row at a time: waveform, pitch, detune.
  cursor wave_table {
    table @ ins width 3;
    pos wftpos;
    on wave step;
    match c0 { _ => value(); }
  }

  // Before a row is read, its one-shot columns are cleared and the orderlist's delayed volume
  // and track tempo take effect.
  handler row_prep on row {
    curifx := 0;
    curfx2 := 0;
    if L.seq_fx_support {
      mainvol := seqvolu;
    }
    if L.tempoprgsupp && seqtempo != 0 {
      track_tempo(seqtempo | 0x80);
      seqtempo := 0;
    }
  }

  // A pattern row: note, then instrument, effect and value as each byte before asks; a note of
  // $70..$77 is a run of empty rows.
  cursor row_reader { stream @ ptnptr[curptn] + L.swp_base; pos ptnpos last;
    on row next;
    on pattern_end reset;
    on advance settle;
    run 0x70..0x77 base 0x6F -> packcnt;
    field note -> curnot = note & 0x7F;
    field inst when neg(note) -> curifx = inst & 0x7F;
    field fx when neg(inst) -> curfx2 = fx;
    field value when (fx & 0xE0) == 0 -> curval = value;
  }

  // The carry the tables leave for the detune add.
  signal c: bool = false;

  // The tick counter against the tempo program: it starts over when it reaches the program's
  // byte, which then moves on; a signed overflow in that compare restarts the program.
  signal due: bool = false;
  signal ticks: u8 = 0;
  handler tempo_program on frame {
    let tempo = ite(L.tempoprgsupp, tempotbl[tmppos + 1], main_tempo);
    let diff = spdcnt - tempo;
    due := diff == 0 || neg((spdcnt ^ tempo) & (spdcnt ^ diff));
    ticks := ite(due || spdcnt == 0, 0, spdcnt);
    if L.tempoprgsupp {
      if diff == 0 {
        tmppos += 1;
      } elif due {
        tmppos := tmpbase;
      }
    }
  }
  counter beat: spdcnt { on frame += 1; reload 1; wrap when due || spdcnt == 0 -> row; }

  // An SFX build's sound effect on the third voice: its timer counts down from the effect's
  // length, the first frame starting the note, the last giving the music's instrument back and
  // silencing the voice.
  proc sfx_frame() {
    let t = sfxtimer;
    if t == 0 {
      curins := curinstemp;
      if !L.allghostregs {
        put_ad(0);
        put_sr(0);
        put_wave(0);
      }
    } elif neg(t) {
      return;
    } elif t == sfxleng {
      note_start(cpu.y);
    }
    sfxtimer -= 1;
  }

  handler row_tail on row {
    if L.sfx && x == 2 && !neg(sfxtimer) {
      curfx2 := 0;
      curnot := 0;
      let y = curifx;
      if y != 0 {
        if y < LEGATO {
          curinstemp := y;
        }
        curifx := 0;
        c := y >= LEGATO;
        hr_tables();
        return;
      }
    }
    if L.fastspeedbind && neg((tempotbl[tmppos + 1] & 0x7F) - 2) {
      pattern_step();
    } else {
      hard_restart(2);
    }
  }

  signal played: bool = false;

  step {
    if played {
      restart();
      return;
    }
    played := true;
    if L.sfx && x == 2 && !L.mulply {
      sfx_frame();
    }
    if L.mulply {
      c := mulcarry;
      multispeed();
      mulcarry := c;
      return;
    }
    fire frame;
    match ticks {
      0 => {}
      2 => tick_2();
      1, 0x80..0xFF => pattern_step();
      _ => instrument_frame();
    }
  }

  // Tick 1: the delayed transpose takes effect and, once the pattern has played out, the
  // orderlist moves on. At tempos of three or less the next tick follows within the call.
  proc pattern_step() {
    if L.transposesupp {
      transp := transp2;
    }
    if row_reader.idle {
      if row_reader.ahead == 0xFF {
        let more = next_pattern();
        if !more {
          return;
        }
        fire pattern_end;
      } else {
        fire advance;
      }
    }
    if L.fastspeedbind && neg((tempotbl[tmppos + 1] & 0x7F) - 3) {
      tick_2();
    } else {
      hard_restart(1);
    }
  }

  // The voice's registers: the chip's directly, or in a build with ghost registers the copy
  // the shared step writes out.
  proc put_freq(v: u16) {
    g_freq := v;
    if !L.allghostregs {
      out_freq := v;
    }
  }

  proc put_pw(v: u16) {
    g_pw := v;
    if !L.allghostregs {
      out_pw := v;
    }
  }

  proc put_wave(v: u8) {
    g_wave := v;
    if !L.allghostregs {
      out_wave := v;
    }
  }

  proc put_ad(v: u8) {
    g_ad := v;
    if !L.allghostregs {
      out_ad := v;
    }
  }

  proc put_sr(v: u8) {
    g_sr := v;
    if !L.allghostregs {
      out_sr := v;
    }
  }

  // The orderlist from SEQPOS+1: a pattern, the track's end ($FE: the clock held), a jump ($FF,
  // a target of $80 or more a subtune) or an effect (transpose, volume, track tempo).
  proc next_pattern() -> bool {
    let y = seqpos + 1;
    while true bound 512 {
      let a = orderlist[y].b;
      if !neg(a) {
        curptn := a;
        seqpos := y;
        return true;
      }
      if a == 0xFE {
        spdcnt -= 1;
        instrument_frame();
        return false;
      }
      if a == 0xFF {
        let target = orderlist[y + 1].b;
        if neg(target) {
          if L.subtunejump {
            subtpos := target << 3;
            seqt := word(subt1[x * 2 + subtpos], subt2[x * 2 + subtpos + 1]) + L.swp_base;
          }
          if L.subtune_restarts {
            subtjmp := target;
          }
          target := 0;
        }
        y := target;
      } else {
        if !L.seq_fx_support {
          return true;
        }
        order_effect(a);
        y += 1;
        if orderlist[y].b == 0xFF {
          return true;
        }
      }
    }
    return true;
  }

  // An orderlist effect: $80..$9F the delayed transpose, $A0..$AF the delayed volume, the rest
  // the delayed track tempo (to $EF in later releases).
  proc order_effect(a: u8) {
    if a < 0xA0 {
      if L.transposesupp {
        transp2 := a - 0x90;
      }
    } elif a < 0xB0 {
      seqvolu := a.lo;
    } elif L.tempoprgsupp && (a < 0xF0 || !L.seq_tempo_capped) {
      seqtempo := a - 0xB0;
    }
  }

  // SID-Wizard 1.0 starts a subtune by running every voice's orderlist again from its start,
  // up to the first pattern.
  proc restart() {
    transp2 := 0;
    seqtempo := 0;
    ptnpos := 0;
    tmppos := 0;
    tmpbase := 0;
    seqpos := 0;
    subtjmp := 0;
    if L.restart_trdelay {
      trdelay := 0xFF;
    }
    let y = 0;
    while true bound 256 {
      let a = orderlist[y].b;
      if !neg(a) {
        curptn := a;
        return;
      }
      if a >= 0xFE {
        return;
      }
      order_effect(a);
      y += 1;
      seqpos := y;
      if y == 0 {
        curptn := 0;
        return;
      }
    }
  }

  // The hard restart of a coming note (not a note effect, tone portamento or legato): gate off
  // and the instrument's HR ADSR on the tick its control byte selects, the test bit if asked.
  proc hard_restart(timer: u8) {
    let y = curifx;
    if curnot == 0 || curnot >= NOTE_FX || curfx2 == PORTAMENTO || y == LEGATO
        || (L.portame_notefx && slidevib == NOTE_PORTA) {
      instrument_frame();
      return;
    }
    c := ite(!L.hardrestypes || y != 0, y >= LEGATO, curfx2 >= PORTAMENTO);
    if L.hardrestypes {
      ins := insptr[ite(y == 0 || !neg(y - LEGATO), curins, y)] + L.swp_base;
      if instrument.control & timer == 0 {
        hr_tables();
        return;
      }
    }
    if L.hrender_inline {
      if L.hrgtoff_or8 {
        if instrument.control & 4 != 0 {
          ptngate := 0xFE;
          wfghost := wfghost & 0xFE | 0x08;
        }
      } else {
        if instrument.control & 4 != 0 {
          wfghost := 0x18;
        }
        ptngate := 0xFE;
        wfghost &= 0xFE;
      }
      put_ad(instrument.hr_ad);
      put_sr(instrument.hr_sr);
      put_wave(wfghost);
      return;
    }
    ptngate := 0xFE;
    wfghost &= 0xFE;
    if L.hardrestypes {
      put_sr(instrument.hr_sr);
      put_ad(instrument.hr_ad);
      if instrument.control & 4 != 0 {
        wfghost := 0x18;
        put_wave(0x18);
        return;
      }
    } else {
      put_ad(0x0F);
      put_sr(0);
    }
    hr_tables();
  }

  // The tables a hard-restart tick runs after the restart: the waveform table, or all from the
  // vibrato and slides, the filter or the pulse table on, as the build does.
  proc hr_tables() {
    ins := insptr[curins] + L.swp_base;
    tables(ite(L.vibslidealways, 0, ite(L.filteralways, 1, ite(L.pulsealways, 2, 3))));
  }

  // Tick 2: the row's instrument (below the limit, also resetting the pulse and filter tables),
  // then the note: started, slid to, or a note effect; then the row's effects.
  proc tick_2() {
    let mask = 0xFF;
    if curifx != 0 && neg(curifx - L.sel_ins_limit) {
      curins := curifx;
      mask := 0x3F;
    }
    note_start(mask);
  }

  // The note of a row, the pulse and filter tables' reset bits being those of `mask`.
  proc note_start(mask: u8) {
    tablrst := mask;
    if curins == 0 {
      if !L.noins_rts {
        effects();
        put_wave(wfghost);
      }
      return;
    }
    ins := insptr[curins] + L.swp_base;
    let note = curnot;
    if note >= NOTE_FX {
      if note < 0x78 {
        if !L.vibamfx_amp_only {
          valstor := note;
        }
        vibrato_amplitude(note);
      } else {
        note_effect(note - 0x78);
      }
      effects();
      tables(0);
      return;
    }
    if note == 0 {
      effects();
      tables(0);
      return;
    }
    dpitch := note + ite(L.octaveshift, instrument.octave, 0) + ite(L.transposesupp, transp, 0);
    if curfx2 == PORTAMENTO {
    } elif L.portame_notefx && carry(PORTAMENTO, slidevib, PORTAMENTO >= curfx2) {
      slidevib := TONE_PORTA;
    } elif curifx != LEGATO {
      start_sound();
    } else {
      freqmod := word(lo(freqmod), 0x7F);
      slidevib := TONE_PORTA;
    }
    effects();
    put_wave(wfghost);
  }

  // A note's sound: control byte (masked by the reset bits), first-frame waveform, tables from
  // their starts, vibrato, chord, filter table and ADSR.
  proc start_sound() {
    if L.sound_resets_flshift {
      flshift := 0;
    }
    insctrl := instrument.control;
    if L.pwresetsw || L.filtresetsw {
      insctrl &= tablrst;
    }
    slidevib := insctrl & 0x30;
    if !L.frame1switch {
      wfghost := 0x09;
    } elif insctrl & 8 != 0 {
      if L.first_frame_fixed_waveform {
        wfghost := 0x09;
      } else {
        put_freq(word(lo(g_freq), freqtbh[ite(L.first_frame_freq_by_track, x * 7, dpitch)]));
        wfghost := instrument.first_wave;
      }
    }
    wftpos := WAVE_START;
    ptngate := 0xFF;
    if L.multispeedsupp {
      arpscnt := 0xFF;
    }
    if L.arpspeedsupp {
      arpsped := instrument.arp_speed;
    }
    videlcnt := instrument.vibrato_delay;
    set_vibrato(instrument.vibrato);
    if L.chordsupport {
      curchord := instrument.chord;
      chordpos := chdp[curchord];
    }
    if !L.pwresetsw || insctrl & 0x40 == 0 {
      pwtpos := instrument.pw_start;
    }
    if !L.filtresetsw || !neg(insctrl) {
      start_filter();
    }
    put_sr(instrument.sr);
    put_ad(instrument.ad);
  }

  // The instrument's filter table: $00 filters the voice without taking the filter, $FF
  // unfilters it, anything else takes the filter from that row.
  proc start_filter() {
    let y = instrument.filter_start;
    let row = insdata[y].b;
    if row != 0xFF {
      react filter_owner on note(x * 7, 0xFF, row != 0);
      if row != 0 {
        fltposi := y;
      }
      if flswtbl | fswitch != 0 {
        fswitch |= flswtbl;
        return;
      }
    }
    if L.filter_stop_rewinds && filter_owner.mine {
      fltposi := y;
    }
    fswitch &= flswtb2;
  }

  proc instrument_frame() {
    if curins != 0 {
      ins := insptr[curins] + L.swp_base;
      tables(0);
    }
  }

  // Vibrato and slides, then the filter, pulse and waveform tables; a later `from` starts at
  // the stage it names (1 the filter, 2 the pulse, 3 the waveform).
  proc tables(from: u8) {
    if from == 0 {
      let mode = slidevib;
      if L.vibratotypes && mode == 0 {
        freqmod += u16(videlcnt);
        vibrato();
      } elif !neg(mode) {
        if neg(videlcnt) {
          vibrato();
        } else {
          videlcnt -= 1;
        }
      } elif mode == 0x82 {
        freq -= freqmod;
      } elif mode == 0x81 {
        freq += freqmod;
      } elif L.portavibra && mode == NOTE_PORTA {
        freq := word(freqtbl[dpitch], freqtbh[dpitch]);
      } else {
        portamento();
      }
    }
    if from <= 1 && filter_owner.mine {
      fire filter;
    }
    let a = lo(ins);
    if from == 3 && L.swp {
      c := false;
    }
    if from <= 2 {
      pulse_width();
      a := lo(pw);
    }
    wave_frame(a);
  }

  // Multispeed: once the first frame has passed, the instrument's arp speed picks the tables
  // run: bit 7 the filter, bit 6 the pulse, the waveform always.
  proc multispeed() {
    if neg(arpscnt) {
      return;
    }
    ins := insptr[curins] + L.swp_base;
    let speed = instrument.arp_speed;
    if neg(speed) && filter_owner.mine {
      fire filter;
    }
    if !neg(speed) && speed & 0x40 == 0 && L.swp {
      c := false;
    }
    if neg(speed) || speed & 0x40 != 0 {
      pulse_width();
    }
    wave_frame(ite(neg(speed) || speed & 0x40 != 0, lo(pw), 0));
  }

  // The pulse table's row, then the pulse width register: its high byte plus the keyboard
  // track's scaling of the note.
  proc pulse_width() {
    let f = false;
    react pw_table on pulse() -> f;
    c := f;
    if !L.pwkeybtrack {
      put_pw(pw);
      return;
    }
    let k = 0;
    c := false;
    if pkbdtrk != 0 {
      let i = pkbdtrk + dpitch;
      let c1 = carry(pkbdtrk, dpitch);
      k := exptabh[i] - exptabh_m1[i] - u8(!c1);
      c := !borrow(exptabh[i], exptabh_m1[i], !c1);
    }
    let t = u16(hi(pw)) + u16(k) + u16(c);
    put_pw(word(lo(pw), lo(t)));
    c := t > 0xFF;
  }

  // Tone portamento: a step of FREQMOD towards the note, or the note once within a step.
  proc portamento() {
    let t = word(freqtbl[dpitch], freqtbh[dpitch]);
    let r = u16(L.portavibra);
    let d = t - freq - r;
    if t >= freq + r {
      if d >= freqmod {
        freq += freqmod + 1;
      } else {
        arrive(t);
      }
    } elif d + freqmod < d {
      arrive(t);
    } else {
      freq -= freqmod + 1;
    }
  }

  // A slide reaching its note, which also gives the instrument's vibrato back.
  proc arrive(t: u16) {
    if L.portavibra {
      slidevib := instrument.control & 0x30;
      set_vibrato(instrument.vibrato);
    }
    freq := t;
  }

  // The vibrato: VIBRACNT counts VIBFREQU down, sliding up through its lower half.
  proc vibrato() {
    vibracnt := ite(vibracnt == 0, vibfrequ, vibracnt) - 1;
    if vibracnt << 1 < vibfrequ {
      freq += freqmod;
    } else {
      freq -= freqmod;
    }
  }

  // The waveform table every ARPSPED+1 frames, then frequency (plus detune and the carry) and
  // waveform out.
  proc wave_frame(a: u8) {
    let row = true;
    let reload = a;
    if L.arpspeedsupp {
      arpscnt -= 1;
      row := neg(arpscnt);
      reload := arpsped;
    }
    if row {
      arpscnt := reload & 0x3F;
      wave_row();
    }
    let f = freq + ite(L.detunesupport, u16(detuner) + u16(c), 0);
    put_freq(f);
    if L.detunesupport {
      c := f < freq;
    }
    put_wave(wfghost);
  }

  // A waveform-table row: $00..$0F the row's repeat, $10..$FD the waveform, $FE jumps, $FF
  // stops; the pitch is relative below $80, none at $80, absolute to $DF, relative down above,
  // or the chord ($7F); the detune ($FF keeps it). A chord walks CHORDS, $7E back to the table.
  proc wave_row() {
    while true bound 256 {
      let wave = wave_table.c0;
      let set = true;
      if wave == 0xFE {
        if neg(wave_table.c1) {
          c := true;
          return;
        }
        wftpos := wave_table.c1;
        wave := wave_table.c0;
      } elif wave == 0xFF {
        c := true;
        return;
      } elif L.arpspeedsupp && wave < 0x10 {
        arpscnt := wave;
        set := false;
      }
      if set {
        wfghost := wave & ptngate;
      }
      let pitch = wave_table.c1;
      if L.chordsupport && pitch == 0x7F {
        detuner := wave_table.c2;
        let note = chdt[chordpos];
        if note != 0x7E {
          if note == 0x7F {
            chordpos := chdp[curchord];
            note := chdt[chordpos];
          }
          chordpos += 1;
          let r = relative_note(note);
          c := r;
          return;
        }
        chordpos := chdp[curchord];
        react wave_table on wave();
      } else {
        if L.detunesupport && wave_table.c2 != 0xFF {
          detuner := wave_table.c2;
        }
        react wave_table on wave();
        if L.wfarp_nop_supp && pitch == 0x80 {
          c := true;
        } elif neg(pitch) && pitch < 0xE0 {
          freq := word(freqtbl[pitch & 0x7F], freqtbh[pitch & 0x7F]);
          c := false;
        } else {
          c := relative_note(pitch);
        }
        return;
      }
    }
  }

  proc relative_note(a: u8) -> bool {
    let n = (a + dpitch) & 0x7F;
    freq := word(freqtbl[n], freqtbh[n]);
    return carry(a, dpitch);
  }

  // The slide or vibrato step for an amplitude: scaled by the note through the exponent table,
  // or the value itself when zero.
  proc set_step(a: u8) {
    let y = a;
    if L.calcvibrato {
      if a == 0 {
        freqmod := 0;
        return;
      }
      y := (a >> 1) + dpitch + u8(a & 1 != 0);
    }
    if y >= L.exp_end {
      y := L.exp_end;
    } elif y < L.exp_threshold {
      freqmod := u16(exptbase[y]);
      return;
    }
    freqmod := word(vib_lo[y], vib_hi[y]);
  }

  proc set_vibrato(a: u8) {
    vibfrequ := a.lo << 1;
    vibracnt := ite(L.vibratotypes && slidevib == 0x30, 0, ite(!L.vibratotypes || neg(slidevib - 0x20), a.lo >> 1, a.lo));
    set_step(a.hi << 3);
  }

  proc vibrato_amplitude(a: u8) {
    slidevib := instrument.control & 0x30;
    if L.vibamfx_amp_only {
      set_step(a.lo << 3);
    } else {
      let b = instrument.vibrato;
      b.hi := valstor;
      set_vibrato(b);
    }
  }

  // Note effects $78..: portamento at the default speed, sync and ring on and off, gate on,
  // gate off (to the instrument's gate-off table positions).
  proc note_effect(k: u8) {
    match k {
      0, 7 => {
        if L.portame_notefx {
          slidevib := NOTE_PORTA;
          set_step(110);
        } elif k == 7 {
          wfghost |= 2;
        }
      }
      1 => wfghost |= 2;
      2 => wfghost &= 0xFD;
      3 => wfghost |= 4;
      4 => wfghost &= 0xFB;
      5 => {
        ptngate := 0xFF;
        wfghost |= 1;
      }
      _ => {
        if L.gateoffptr && instrument.gateoff_wf != 0 {
          wftpos := instrument.gateoff_wf;
        } else {
          ptngate := 0xFE;
          wfghost &= 0xFE;
        }
        if L.gateoffptr && instrument.gateoff_pw != 0 {
          pwtpos := instrument.gateoff_pw;
        }
        if L.gateoffptr && filter_owner.mine && instrument.gateoff_filter != 0 {
          fltposi := instrument.gateoff_filter;
        }
      }
    }
  }

  // The instrument column's small effect ($40..), then the row's effect: big ($01..$1F, with
  // the value) or small ($20..).
  proc effects() {
    if curifx >= 0x40 && curifx < 0xC0 {
      small_effect(curifx);
    }
    let fx = curfx2;
    if fx >= 0x20 {
      small_effect(fx);
    } elif fx != 0 {
      big_effect(fx, curval);
    }
  }

  // A small effect: the high nibble picks it, the low nibble is its value.
  proc small_effect(a: u8) {
    let v = a.lo;
    valstor := v;
    match a.hi {
      2 => {
        let b = ite(L.allghostregs, g_ad, instrument.ad);
        b.hi := v;
        put_ad(b);
      }
      3 => {
        let b = ite(L.allghostregs, g_ad, instrument.ad);
        b.lo := v;
        put_ad(b);
      }
      4 => wfghost.hi := v;
      5 => {
        let b = ite(L.allghostregs, g_sr, instrument.sr);
        b.hi := v;
        put_sr(b);
      }
      6 => {
        let b = ite(L.allghostregs, g_sr, instrument.sr);
        b.lo := v;
        put_sr(b);
      }
      7 => set_chord(v);
      8 => vibrato_amplitude(v);
      9 if L.vibfreqfx_supp => vibfrequ := v << 1;
      0x0A => {
        mainvol := v;
        if L.seq_fx_support {
          seqvolu := v;
        }
      }
      0x0B if L.filter_smallfx => fltband := v << 4;
      0x0C => set_arp_speed(v);
      0x0D if L.detune_smallfx => detuner := v << 3;
      0x0D, 0x0E if L.wfctrl_smallfx && L.wfctrl_fx_stores => wfghost.lo := valstor;
      0x0F if L.filter_smallfx => resonib := v << 4;
    }
  }

  proc set_chord(a: u8) {
    if L.chordsupport {
      curchord := a;
      chordpos := chdp[a];
    }
  }

  proc set_arp_speed(a: u8) {
    if L.arpspeedsupp {
      arpsped := a;
      arpscnt := 0xFF;
    }
  }

  // A big effect with its value: slides and portamento, waveform, ADSR, chord, vibrato, table
  // positions, arp speed, detune, pulse width, cutoff, tempos, vibrato type, filter shift and
  // filter switch with resonance.
  proc big_effect(n: u8, a: u8) {
    match n {
      1..3 => {
        slidevib := 0x80 + n;
        set_step(a);
      }
      4 => {
        if L.bigfx_v10 && a >= 0xF0 {
          let m = times3(a.lo);
          wftpos := m + WAVE_START;
        } else {
          wfghost := a;
        }
      }
      5 => put_ad(a);
      6 => put_sr(a);
      7 => set_chord(a);
      8 => {
        slidevib := instrument.control & 0x30;
        set_vibrato(a);
      }
      9 => {
        if L.bigfx_v10 {
          slidevib := a & 0x30;
        } else {
          let m = times3(a);
          wftpos := m + WAVE_START;
        }
      }
      0x0A => {
        let m = times3(a);
        pwtpos := m + instrument.pw_start;
        if L.table_fx_resets {
          pweepcnt := 0;
        }
      }
      0x0B => {
        let m = times3(a);
        fltposi := m + instrument.filter_start;
        if L.table_fx_resets {
          cwepcnt := 0;
        }
      }
      0x0C => set_arp_speed(a);
      0x0D => {
        detuner := a;
        if L.bigfx0d_falls {
          pw := word(lo(pw), a.lo);
        }
      }
      0x0E => pw := word(lo(pw), a.lo);
      0x0F => {
        if L.bigfx_v10 {
          flshift := a;
        } elif L.finefiltsweep {
          cutoff := word(lo(cutoff), a);
        } else {
          coarse := a;
        }
      }
      0x10 => {
        if L.tempoprgsupp {
          tempotbl[1] := a | 0x80;
          all_tempo(0);
        } else {
          main_tempo := a | 0x80;
        }
      }
      0x11 if L.tempoprgsupp => {
        tempotbl[2] := a.lo | 0x80;
        tempotbl[1] := a.hi;
        all_tempo(0);
      }
      0x12 if L.tempoprgsupp => {
        if a != 0 {
          all_tempo(tmpp[a]);
        }
      }
      0x13 if L.tempoprgsupp => track_tempo(a | 0x80);
      0x14 if L.tempoprgsupp => {
        track_tempo(a.hi);
        tempotbl[trktmpos + 2] := a.lo | 0x80;
      }
      0x15 if L.tempoprgsupp => {
        if a != 0 {
          tmpbase := tmpp[a];
          tmppos := tmpp[a];
        }
      }
      0x16..0x1D if L.bigfx_delay_16 => {
        if L.delaysupport {
          delay(a);
        }
      }
      0x16 => {
        if !L.bigfx_v10 {
          slidevib := a & 0x30;
        }
      }
      0x17..0x1C => {
        if L.filtshift_supp && !L.bigfx_v10 {
          flshift := a;
        }
      }
      0x1D => {
        if L.delaysupport {
          delay(a);
        }
      }
      0x1E => {
        if L.delaysupport {
          if trdelay == 0 {
            spdcnt += a;
            delay(spdcnt);
          } else {
            delay(a);
          }
        }
      }
      _ => {
        if L.filt_ctrl_fx {
          fswitch := a.lo;
          resonib := a & 0xF0;
        }
        if L.bigfx1f_toggle {
          fswitch ^= 0x08;
        }
      }
    }
  }

  // A track delay holds the voice's clock while its counter runs down.
  proc delay(a: u8) {
    if trdelay != 0 {
      if trdelay == 0xFF {
        trdelay := a;
      }
      spdcnt := 2;
    }
    trdelay -= 1;
  }

  proc times3(a: u8) -> u8 {
    let t = u16(a) * 3;
    return lo(t) + hi(t);
  }

  // Every voice's tempo program from A.
  proc all_tempo(a: u8) {
    for v in L.order {
      voice[v].tmppos := a;
      voice[v].tmpbase := a;
    }
  }

  // This voice's own tempo at its slot of the tempo program.
  proc track_tempo(a: u8) {
    tempotbl[trktmpos + 1] := a;
    tmpbase := trktmpos;
    tmppos := trktmpos;
  }
}

// The shared registers: filter switches and resonance, volume and band, and the cutoff (its top
// byte scaled by the filter owner's note through the keyboard track, then shifted).
machine commonregs {
  step {
    if L.allghostregs {
      for v in L.order {
        voice[v].out_freq := voice[v].g_freq;
        voice[v].out_pw := voice[v].g_pw;
        voice[v].out_wave := voice[v].g_wave;
        voice[v].out_ad := voice[v].g_ad;
        voice[v].out_sr := voice[v].g_sr;
      }
    }
    sid_resfc := fswitch | resonib;
    if !L.echo_support {
      sid_fmvol := mainvol | fltband;
    }
    let cut = ite(L.finefiltsweep, hi(cutoff), coarse);
    let top = cut;
    let c = false;
    if L.filtkbtrack && ckbdtrk != 0 {
      let p = 0;
      for v in L.order {
        if fltctrl == v * 7 {
          p := voice[v].dpitch;
        }
      }
      let k = exptabh[ckbdtrk + p];
      c := carry(ckbdtrk, p);
      top := k + cut + u8(c);
      c := carry(k, cut, c);
    }
    if L.filtshift_supp {
      top := top + flshift + u8(c);
    }
    sid_fcut := u16(top) << 3 | u16(lo(cutoff) & 7);
  }
}

// The play call's entry: a hand-edited player toggles its own gate and plays on alternate calls,
// and the carry a multispeed call enters with passes from voice to voice.
machine play {
  step {
    if L.play_gate {
      let g = gate ^ L.gate_mask;
      gate := g;
      if neg(g) != L.gate_minus {
        finish;
      }
    }
    mulcarry := cpu.c;
    if L.retainzeropage {
      ins := L.init_zp;
    }
  }
}

// A subtune started from an orderlist jump (SID-Wizard 1.0): the subtune's orderlists and main
// tempos are set, then every voice restarts.
machine subtune {
  signal jump: bool = false;

  step {
    if subtjmp != 0 {
      let y = (subtjmp & 0x7F) << 3;
      for v in L.order {
        voice[v].seqt := word(subt1[y + v * 2], subt1[y + v * 2 + 1]);
      }
      tempotbl[1] := subt1[y + L.chn * 2];
      tempotbl[2] := subt2[y + L.chn * 2];
      jump := true;
    }
  }
}

schedule {
  play;
  if !L.mulply || L.multispeedsupp {
    for v in L.order {
      voice[v];
    }
    if L.subtune_restarts {
      subtune;
      if subtune.jump {
        for v in L.order {
          voice[v];
        }
      }
    }
    commonregs;
  }
}
